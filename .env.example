# tripps configuration. Copy to `.env` and edit — every value here is already the default,
# so an empty `.env` (or none at all) is a working setup. No credentials are required to run:
# the GTFS feed is CC0 and served unauthenticated, and every price source is reached without
# a key of ours.
#
# Every setting in config.py is reachable as TRIPPS_<FIELD_NAME>; these are the ones worth
# knowing about. Nested groups use their own prefix, TRIPPS_BUDGET_ and TRIPPS_TTL_.

# --- Where state lives -------------------------------------------------------
# Point this at a volume to keep the feed, the parsed timetable cache and the SQLite DB
# outside the checkout. The feed and the database follow this directory unless you also
# set TRIPPS_GTFS_ZIP_PATH / TRIPPS_DB_PATH explicitly.
#TRIPPS_DATA_DIR=./data
#TRIPPS_GTFS_ZIP_PATH=./data/sweden.zip
#TRIPPS_DB_PATH=./data/tripps.sqlite3

# --- Who is travelling, when a search does not say ---------------------------
# adult | student | youth | senior | child
#TRIPPS_PASSENGER=adult
#TRIPPS_PASSENGER_AGE=

# --- How hard to work per search ---------------------------------------------
# Raising these buys more priced options and costs latency and upstream calls.
#TRIPPS_BUDGET_MAX_CALLS_PER_SOURCE_PER_SEARCH=12
#TRIPPS_BUDGET_MAX_CANDIDATES_TO_PRICE=30
#TRIPPS_BUDGET_ENABLE_SPLIT_TICKETS=true

# --- Background work ---------------------------------------------------------
# Re-run price-source canaries, recalibrate routing floors, reload them. 0 disables.
#TRIPPS_SCHEDULER_SECONDS=21600
#TRIPPS_FREERIDER_POLL_SECONDS=300
# Canary results older than this are shown greyed out on /status rather than as fact.
#TRIPPS_CANARY_STALE_HOURS=24

# --- Optional external services ----------------------------------------------
# Self-hosted OSRM for Freerider road legs. Unset falls back to a great-circle estimate,
# which under-reads real driving distance on anything but a straight motorway.
#TRIPPS_OSRM_BASE=

# Trafiklab documents a key on the GTFS download but does not currently require one
# (verified 2026-07-10). It is sent when set, so this is future-proofing, not a prerequisite.
#TRIPPS_TRAFIKLAB_GTFS_KEY=
# ResRobot's route planner / stop lookup has its own quota tier and its own key.
#TRIPPS_TRAFIKLAB_RESROBOT_KEY=
